# Escudo — environment. Copy to .env (gitignored) and fill the blanks.
#
# Deployed API (Cloud Run service escudo-api, us-central1):
#   https://escudo-api-611681112050.us-central1.run.app
#   MCP:        https://escudo-api-611681112050.us-central1.run.app/mcp
#   Agent Card: https://escudo-api-611681112050.us-central1.run.app/a2a/escudo/.well-known/agent-card.json
#   Chat:       wss://escudo-api-611681112050.us-central1.run.app/assistant/chat

# --- Google Cloud / Vertex AI (ADC) --------------------------------------------
GOOGLE_CLOUD_PROJECT=ai-experiments-487722
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=true
# Local user ADC: bill Firebase Auth admin calls (make seed) to this project.
GOOGLE_CLOUD_QUOTA_PROJECT=ai-experiments-487722

# --- Models (never hard-coded) ---------------------------------------------------
# Text and vision: the Escudo Assistant chat, the damage assessor and the Escudo A2A agent.
GEMINI_MODEL=gemini-3.8-flash
# Sample crash photos (scripts/generate_sample_photos.py), global endpoint.
IMAGE_MODEL=gemini-3.1-flash-lite-image

# --- Data ------------------------------------------------------------------------
FIRESTORE_DATABASE=escudo
CLAIMS_BUCKET=ai-experiments-487722-escudo-claims
# firestore | memory (memory is the default when MOCK_AI=1)
# STORE=firestore

# --- Surfaces --------------------------------------------------------------------
# Base URL this service advertises in its Agent Cards and MCP metadata.
PUBLIC_BASE_URL=http://127.0.0.1:8080
# A2A partners: base URLs only. Escudo reads each Agent Card at
# {base}/.well-known/agent-card.json and calls the RPC URL the card declares.
A2A_PEERS=http://127.0.0.1:8080/a2a/tow,http://127.0.0.1:8080/a2a/repair
DEMO_CUSTOMER_ID=cus_demo
# Optional shared secret for the internal partners: Tow/Repair answer only callers sending it in
# X-Escudo-A2A-Key, and their Agent Cards declare that scheme. Empty = open (local dev, tests).
# In Cloud Run it is the Secret Manager secret escudo-a2a-secret (infra/06-secrets.sh).
A2A_SHARED_SECRET=

# --- Modes -----------------------------------------------------------------------
# MOCK_AI=1: no Gemini/Firestore/FCM (deterministic assessor and partner agents, in-memory store).
MOCK_AI=0
# MOCK_AUTH=1: accept any caller as the demo customer (local only, never deployed).
MOCK_AUTH=0

# --- Secrets (never commit real values) ----------------------------------------
# Protects POST /admin/reset. Only for a local server: in Cloud Run it is the Secret Manager secret
# escudo-admin-token (infra/06-secrets.sh); `make reset CLOUD=1` reads it from there.
ADMIN_TOKEN=
# Firebase Web API key (public client config), used by `make scenario` to sign in as the seeded
# customer (email/password from .env.local, written by `make seed`):
#   gcloud services api-keys get-key-string b6c3370b-e8d5-4007-81fc-087e18079c0d --project ai-experiments-487722
FIREBASE_WEB_API_KEY=

# --- Scenario runner ---------------------------------------------------------------
ESCUDO_BASE_URL=http://127.0.0.1:8080
